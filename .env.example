# Development environment (.env)
# Copy to .env before: docker compose -f docker-compose.dev.yml up

ENVIRONMENT=development

POSTGRES_DB=barbershop
POSTGRES_USER=barber
POSTGRES_PASSWORD=change-me

DATABASE_URL=postgresql+asyncpg://barber:change-me@localhost:5432/barbershop
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173

# Development-only JWT (never use in production)
JWT_SECRET=change-me-in-development

# Dev seed users (reset on each backend init in development)
ADMIN_EMAIL=admin@ronalbarber.com
ADMIN_PASSWORD=admin
BARBER_DEFAULT_PASSWORD=barber1

# Email (SMTP) — optional in development
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ronalbarber.com
SMTP_USE_TLS=true

# Telegram bot — optional in development
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=ronalbarber_bot
TELEGRAM_WEBHOOK_SECRET=

# Scheduler
SCHEDULER_ENABLED=true
REMINDER_HOURS_BEFORE=24
REMINDER_WINDOW_MINUTES=15
