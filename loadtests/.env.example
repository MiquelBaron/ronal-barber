# Base URL of the site/API (include scheme, no trailing slash)
API_BASE_URL=https://ronalbarber504.com

# Staff users on the target environment (required for smoke/load auth steps)
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=replace-me
BARBER_EMAIL=barber@your-domain.com
BARBER_PASSWORD=replace-me

# Booking targets for setup(); override if your seed IDs differ
SERVICE_ID=1
BARBER_ID=1
BOOKING_DAYS_AHEAD=14
# BOOKING_DATE=2026-10-06
# BOOKING_TIME=10:00

# booking-concurrency.js only
CONCURRENT_VUS=50

# Turnstile: any token works with Cloudflare always-pass test secret on the server.
# Against real production keys, smoke/concurrency booking POSTs will get 403 unless you
# temporarily use test keys — k6 cannot solve the widget.
TURNSTILE_TOKEN=loadtest
