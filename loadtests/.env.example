# Base URL of the FastAPI backend (include scheme, no trailing slash)
API_BASE_URL=http://localhost:8000

# Seed users (dev defaults from backend/app/db/init.py)
ADMIN_EMAIL=admin@ronalbarber.com
ADMIN_PASSWORD=admin
BARBER_EMAIL=barber1@ronalbarber.com
BARBER_PASSWORD=barber1

# Booking targets for setup(); override if your seed IDs differ
SERVICE_ID=1
BARBER_ID=1
BOOKING_DAYS_AHEAD=14
# BOOKING_DATE=2026-10-06
# BOOKING_TIME=10:00

# booking-concurrency.js only
CONCURRENT_VUS=50
