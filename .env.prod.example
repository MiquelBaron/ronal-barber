# Production environment
# Copy to .env and fill ALL required values before:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Generate a strong JWT secret (PowerShell example):
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))

ENVIRONMENT=production

POSTGRES_DB=barbershop
POSTGRES_USER=barber
POSTGRES_PASSWORD=replace-with-a-strong-database-password

FRONTEND_ORIGIN=https://your-domain.com
PUBLIC_BASE_URL=https://your-domain.com
# Google review URL is configured in Admin → Settings (google_review_url), not env.
# Loopback-only port for the frontend container (host Nginx proxies here; do not use 80).
HTTP_PORT=8080

# Required — minimum 32 characters, not a known placeholder
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Cloudflare Turnstile — required in production (backend secret; never commit real values)
TURNSTILE_SECRET_KEY=replace-with-cloudflare-turnstile-secret
# Optional override (default: ronalbarber504.com,www.ronalbarber504.com)
# TURNSTILE_EXPECTED_HOSTNAMES=ronalbarber504.com,www.ronalbarber504.com
# Frontend build-time site key (public): pass as compose build arg VITE_TURNSTILE_SITE_KEY

# First-time bootstrap only (when the database has no users).
# Leave empty after the initial admin exists. Never commit real values.
BOOTSTRAP_ADMIN_EMAIL=admin@your-domain.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password-min-12-chars

# Optional integrations
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Prefer Admin → Settings for the error-log bot (token + chat_id).
TELEGRAM_LOGS_BOT_TOKEN=
TELEGRAM_LOGS_CHAT_ID=
SCHEDULER_ENABLED=true
REMINDER_SEND_HOUR=21
REMINDER_TIMEZONE=Europe/Madrid
