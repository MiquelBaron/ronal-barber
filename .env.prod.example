# Production environment
# Copy to .env and fill ALL required values before:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Generate a strong JWT secret (PowerShell example):
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))

ENVIRONMENT=production

POSTGRES_DB=barbershop
POSTGRES_USER=barber
POSTGRES_PASSWORD=replace-with-a-strong-database-password

FRONTEND_ORIGIN=http://localhost
PUBLIC_BASE_URL=http://localhost
HTTP_PORT=80

# Required — minimum 32 characters, not a known placeholder
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# First-time bootstrap only (when the database has no users).
# Leave empty after the initial admin exists. Never commit real values.
BOOTSTRAP_ADMIN_EMAIL=admin@your-domain.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password-min-12-chars

# Optional integrations
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
SCHEDULER_ENABLED=true
REMINDER_HOURS_BEFORE=24
REMINDER_WINDOW_MINUTES=15
